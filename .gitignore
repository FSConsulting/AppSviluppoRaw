# Ignore all root content by default, keep only Ver_02 and workflow files.
/*
!.gitignore
!.github/
!README.md
!Ver_02/

# Allow Ver_02 contents, but ignore common build and temp files inside it.
Ver_02/__pycache__/
Ver_02/*.py[cod]
Ver_02/*.pyo
Ver_02/*.pyd
Ver_02/docs/_build/
Ver_02/.pytest_cache/
Ver_02/*.log
Ver_02/*.sqlite3
Ver_02/*.db
Ver_02/.DS_Store
Ver_02/Thumbs.db

# Ignore top-level generated and local folders
/.vscode/
/AI_Prompt/
/RAW_Input/
/JPG_Output/

# Ignore root temporary and media files
*.mp4
*.srt
_chiusura_ultima_Chat.md

# Ignore the workspace virtual environment at root
/ai_env/
/.ai_env/
/venv/
/ENV/
/env/
